<!--
  multiplayer/choose/index.ejs — Choose activity HTML partial
  ═════════════════════════════════════════════════════════
  Loaded dynamically via $.load() in multiplayer.ejs.
  Provides the DOM structure for the Choose game:
    - Chooser panel: speak button, auto-listen toggle, image grid
    - Guesser panel: selected image preview, word buttons
  Styled with scoped <style> block — CSS classes prefixed with 'choose-'.
  All JS logic lives in lobby/multiplayer/choose.js.
-->
<style>
  .thumb {
    width: 100px;
    cursor: pointer;
  }

  .choose-slide-img, #choose-selected-preview {
    max-width: 220px;
    max-height: 220px;
    border-radius: 12px;
    border: 2px solid #3b82f6;
    background: #f8fbff;
    padding: 0.35rem;
  }

  .choose-word {
    cursor: pointer;
    font-size: 1.5rem;
    font-weight: 700;
    border: 2px solid #d3d7de;
    border-radius: 12px;
    background: #f8fafc;
    color: #1f2a37;
    text-align: center;
    margin: 0.35rem;
    padding: 0.6rem 0.4rem;
    transition: transform 0.15s ease, border-color 0.15s ease, background-color 0.15s ease;
  }

  .choose-word:hover {
    transform: translateY(-1px);
  }

  .choose-word-selected {
    background: #dbeafe;
    border-color: #3b82f6;
    color: #1e40af;
  }

  .choose-word-correct {
    background: #dcfce7;
    border-color: #22c55e;
    color: #166534;
  }

  .choose-word-incorrect {
    background: #fee2e2;
    border-color: #ef4444;
    color: #991b1b;
  }

  .choose-word-disabled {
    cursor: default;
    opacity: 0.6;
  }

  #choose-status {
    min-height: 2rem;
    font-size: 1.35rem;
    line-height: 1.35;
  }

  #choose-listen-btn, #choose-stop-btn {
    min-width: 130px;
  }

  #choose-heard {
    min-height: 1.5rem;
    font-size: 1rem;
  }

  .mic-listening {
    animation: mic-pulse 1.5s infinite;
    box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7);
  }

  @keyframes mic-pulse {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(40, 167, 69, 0.7);
    }
    70% {
      transform: scale(1.05);
      box-shadow: 0 0 0 15px rgba(40, 167, 69, 0);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(40, 167, 69, 0);
    }
  }
</style>

<div class="container">
  <div id="choose-unsupportedAlert" class="alert alert-warning text-center mx-auto my-2" style="max-width:500px; display:none;">
    <i class="material-icons align-middle">warning</i>
    <span class="align-middle ms-1">Speech recognition is not supported in this browser. Please try Google Chrome or Microsoft Edge.</span>
  </div>

  <div class="row">
    <div id="choose-status" class="col-12 text-center text-primary fw-bold mb-2"></div>
  </div>

  <div class="row" id="choose-chooser-panel">
    <div class="col-12 text-center mb-3">
      <button id="choose-listen-btn" class="btn btn-lg btn-success me-2 px-4 shadow" type="button">
        <i class="material-icons align-middle">record_voice_over</i>
        <span class="align-middle ms-1">Start</span>
      </button>
      <button id="choose-stop-btn" class="btn btn-lg btn-secondary px-4 shadow" type="button" disabled>
        <i class="material-icons align-middle">stop</i>
        <span class="align-middle ms-1">Stop</span>
      </button>
      <div id="choose-heard" class="text-secondary mt-2 fw-semibold"></div>
    </div>
    <div id="choose-images" class="col-12 d-flex flex-wrap justify-content-center"></div>
  </div>

  <div class="row d-none" id="choose-guesser-panel">
    <div class="col-12 text-center mb-2">
      <div id="choose-slideshow-container" class="d-flex justify-content-center align-items-center mx-auto mb-2"></div>
      <img id="choose-selected-preview" class="img-fluid d-none" alt="selected image">
    </div>
    <div id="choose-words" class="col-12 d-flex flex-wrap justify-content-center"></div>
  </div>
</div>
