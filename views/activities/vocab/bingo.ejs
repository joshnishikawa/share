<%- include('../../head'); -%>
<style>
  #display > div{ width: 16%;}
  [contenteditable]{ user-select: text; }
</style>

<body>

  
<div class="d-flex" style="position:relative;">
  <%- include('../../menu/item_bingo'); -%>

  <button id="start" class="btn btn-sm btn-outline-success py-0 mx-3" aria-label="Start">
    <i class="material-icons">play_arrow</i>
  </button>

  <div style="position:absolute;right:0;">

    <%- include('../../menu/activity_select', { activity: 'bingo' }); -%>

    <button id="home" class="btn btn-sm btn-outline-secondary p-0" onclick="location.href='<%= query.teacher || (deckType !== 'NH' && deckType !== 'nolink') ? '/teachers/' + deckType : (deckType === 'NH' ? '/NH' : '/') %>'">
      <i class="material-icons">home</i>
    </button>

  </div>
</div>

  <div class="container-fluid" style="min-height:100vh;user-select: none;">
    <div class="row">
      <div id="display" class="col d-flex flex-wrap justify-content-center text-center YM"></div>
    </div>

    <div id="slides" class="row" style="display:none;">
      <div class="col-1 text-center py-1">
        <button id="prev" class="btn btn-light shadow h-100" aria-label="previous slide">
          <i class="material-icons md-large">navigate_before</i>
        </button>
      </div>

      <div class="col-10 text-center p-1">
        <div id="currentSlide" class="text-center YM" style="height:90vh;position:relative;"></div>
      </div>

      <div class="col-1 text-center py-1">
        <button id="next" class="btn btn-light shadow h-100" aria-label="next slide">
          <i class="material-icons md-large">navigate_next</i>
        </button>
      </div>
    </div>

  </div>


<script>
$(function(){
  $("form button[type=submit]").hide();
  
// PREPARE THE DECK ////////////////////////////////////////////////////////////
  const deckType = '<%- deckType %>';
  document.title = `Bingo ${deckType}`;

  var deck = <%- JSON.stringify(deck) %>;
  window.deck = deck;
  var index = 0;
  var started = false;

  function getContent(i, idx){
    let str = i.word.split('(')[0].replace(/_/g, " ");
    if (deckType == "text") return `<div class="rounded-3 bg-white border display-1 p-1"><div class="txt w-100 h-100" contenteditable="true" data-index="${idx}">${str}</div></div>`;
    else {
      let img = i.image ? `<image alt="${str}" src="${i.image}" class="img-fluid">` : '';
      return `<div class="rounded-3 bg-white border display-6 p-1">${img}<br /><div class="txt w-100" contenteditable="true" data-index="${idx}">${str}</div></div>`;
    }
  }
  function getSlide(i, idx){
    let str = i.word.split('(')[0].replace(/_/g, " ");
    if (deckType == "text") {
      // make size proportional to length of string
      let size = Math.max(10, 20 - str.length*2);
      return `<div class="rounded-3 bg-white border h-100" style="font-size:${size}rem;"><div class="txt w-100 h-100" contenteditable="true" data-index="${idx}">${str}</div></div>`;
    }
    else {
      let img = i.image ? `<image alt="${str}" src="${i.image}" class="img-fluid h-75">` : '';
      return `<div class="rounded-3 bg-white border display-6 p-1 h-100">${img}<br/><div class="txt w-100" contenteditable="true" data-index="${idx}">${str}</div></div>`;
    }
  }

// PREPARE THE DISPLAY /////////////////////////////////////////////////////////
  deck.forEach((item, i) => { $('#display').append( getContent(item, i) ); });
  fitText('#display > div');

  function showSlide() {
    $("#currentSlide").html( getSlide(deck[index], index) );
    fitText('#currentSlide > div');
  }

  $(document).on('input blur', '#display [contenteditable], #currentSlide [contenteditable]', function(e){
    const idx = $(this).data('index');
    if (idx === undefined || !deck[idx]) return;
    deck[idx].word = e.type === 'blur' ? $(this).text().trim() : $(this).text();
    if (e.type === 'blur') {
      $(this).text(deck[idx].word);
      $(this).siblings('image, img').attr('alt', deck[idx].word);
      if ($(this).closest('#display').length) fitText('#display > div');
      if ($(this).closest('#currentSlide').length) fitText('#currentSlide > div');
    }
  });

  $(document).on('keydown', '#display [contenteditable], #currentSlide [contenteditable]', function(e){
    if (e.key === "Enter") {
      e.preventDefault();
      $(this).blur();
    }
  });

  $("#start").on('click', ()=>{
    if ($("#slides").is(":hidden")) {
      if (!started) {
        deck = FYshuffle(deck);
        window.deck = deck;
        started = true;
      }
      $("#display").empty();
      $("#start i").text('check_circle');
      $("#start").attr('aria-label', 'Check');
      $("#slides").show();
      showSlide();
    } else {
      $("#slides").hide();
      $("#start i").text('play_arrow');
      $("#start").attr('aria-label', 'Start');
      for (let i=0; i<=index; i++){
        $('#display').append( getContent(deck[i], i) );
      }
      fitText('#display > div');
    }
  });

  $("#prev").on('click', ()=>{
    if (index > 0) {
      index--;
      showSlide();
    }
  });

  $("#next").on('click', ()=>{
    if (index < deck.length-1) {
      index++;
      showSlide();
    }
  });

  $(window).on('resize', ()=>{
    fitText('#display > div');
    fitText('#currentSlide > div');
  });

  $(document).off('keydown').on('keydown', (e)=>{
    if (e.target.isContentEditable || $(e.target).is('[contenteditable]')) return;
    if (e.key == "Enter") $("#start").click();
    if (e.key == "ArrowLeft") $("#prev").click();
    if (e.key == "ArrowRight" || e.keyCode == 32) $("#next").click();
  });

});

</script>

<%- include('../../foot'); -%><!-- FOOT INCLUDES SCRIPTS AND </body> -->
