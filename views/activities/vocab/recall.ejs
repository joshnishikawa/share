<%- include('../../head'); -%>

<style>
  #display > div{ width: 16%;}
</style>

<body>
  <div class="d-flex w-100" style="position:relative;">

    <%- include('../../menu/item_recall'); -%>

    <div id="numselect" class="form-group mx-3">

      <div class="d-flex rounded-3 border border-secondary">
        <label for="numCards" class="form-label px-1 mt-1 mb-0">Hide</label>
        <input id="numCards" type="number" class="form-control form-control-sm border-0" 
              min="1" style="width:3rem;" aria-label="number of cards">
      </div>
    </div>
    
    <button id="start" class="btn btn-sm btn-outline-success py-0 mx-3">
      <i class="material-icons">play_arrow</i>
    </button>
    <button id="replay" class="btn btn-sm btn-outline-success py-0 mx-3" style="display:none;">
      <i class="material-icons">replay</i>
    </button>

    <div class="d-inline-block mx-3">
      <input id="searchInput" class="form-control form-control-sm" type="text" placeholder="Search" aria-label="Search" style="display:none;">
    </div>

    <div style="position:absolute;right:0;">

      <%- include('../../menu/activity_select', { activity: 'recall' }); -%>

      <button id="home" class="btn btn-sm btn-outline-secondary p-0" onclick="location.href='<%= query.teacher || (deckType !== 'NH' && deckType !== 'nolink') ? '/teachers/' + deckType : (deckType === 'NH' ? '/NH' : '/') %>'">
        <i class="material-icons">home</i>
      </button>
    </div>
  </div>


  <div style="min-height:100vh;">
    <div id="display" class="col d-flex flex-wrap justify-content-center text-center YM"></div>
    <div id="gridContainer" style="display:none;">
      <div id="grid" class="d-flex flex-wrap YM" style="user-select: none;"></div>
    </div>
  </div>


<script>
$(function(){
  $("form button[type=submit]").hide(); // Hide the submit button in the form
  const deckType = '<%- deckType %>';
  document.title = `Recall ${deckType}`;

  var deck = <%- JSON.stringify(deck) %>;
  deck = FYshuffle(deck); // Shuffle first so that cards left out are random.
  let {length, colspan, rowheight} = getGrid({length: deck.length, even: false});
  deck = deck.slice(0, length); // Slice the deck to the correct length.
  window.deck = deck;
  let fontsize = Math.floor( deck.length / 6 );

  $("#numCards").val(deck.length);
  $("#numCards").attr('max', deck.length);

// PREPARE THE DISPLAY /////////////////////////////////////////////////////////
  function getContent(i, index){
    let str = i.word.split('(')[0].replace(/_/g, " ");
    if (deckType == "text") return `<div class="rounded-3 bg-white border display-1 p-1"><div class="txt w-100 h-100" contenteditable="true" data-index="${index}">${str}</div></div>`;
    else {
      let img = i.image ? `<image alt="${str}" src="${i.image}" class="img-fluid">` : '';
      return `<div class="rounded-3 bg-white border display-6 p-1">${img}<br/><div class="txt w-100" contenteditable="true" data-index="${index}">${str}</div></div>`;
    }
  }
  deck.forEach((item, index) => {
    $('#display').append(getContent(item, index));
  });
  fitText('#display > div');

  $(document).on('input blur', '#display [contenteditable]', function(e){
    const idx = $(this).data('index');
    if (idx === undefined || !deck[idx]) return;
    deck[idx].word = e.type === 'blur' ? $(this).text().trim() : $(this).text();
    if (e.type === 'blur') {
      $(this).text(deck[idx].word);
      $(this).siblings('image, img').attr('alt', deck[idx].word);
      fitText('#display > div');
    }
  });

  $(document).on('keydown', '#display [contenteditable]', function(e){
    if (e.key === "Enter") {
      e.preventDefault();
      $(this).blur();
    }
  });


// PREPARE THE GRID ////////////////////////////////////////////////////////////
  play = () => {
    $("#grid").empty();
    deck = FYshuffle(deck);
    window.deck = deck;
    for (let i of deck){
      $("#grid").append(
      `<div id="${i.word.replace(/[ ()']/g, '_')}" class="col-${colspan} vocab p-0" style="height:${rowheight}vh;">
          <div class="flip border-primary border-5 rounded-3 m-3" style="height:80%;">
            <div class="flip-card shadow">
              <div class="flip-front bg-white rounded border display-1">
                <img src="${i.image}" class="rounded" 
                   style="max-width:90%;max-height:90%;
                   alt="${i.word}" 
                   onerror="altOnly(this)">
              </div>
              <div class="flip-back rounded border border-warning text-center alert-warning display-${fontsize}">
                &nbsp;
              </div>
            </div>
          </div>
        </div>`);
    }

    $("#display").empty();
    $("#start").hide();
    $("#replay").show();
    $("#searchInput").show().focus();

    let numCards = deck.length - $("#numCards").val(); // Hide (not show) this many cards.
    let cards = $(".vocab");
    let flipped = [];
    for (let i = 0; i < numCards; i++){
      let rand = Math.floor(Math.random() * cards.length);
      flipped.push(cards[rand]);
      cards.splice(rand, 1);
    }
    for (let i of flipped){
      $(i).addClass('flipped').removeClass('flip');
    }

    $("#gridContainer").show();
  }


  $("#start").on('click', play);
  $("#replay").on('click', play);


  $(document).on('dblclick', '.flip', function(){
    $(this).addClass('flipped').removeClass('flip');
  });


  $("#searchInput").on('keyup', function(e){
    if (e.key == "Enter"){
      $(".flip.border")
        .addClass('flipped')
        .removeClass('flip')
        .off('mousedown')
        .promise().done(()=>{
        $(".border-5").removeClass('border');
      });
      $("#searchInput").val("");
    }
    else{
      $(".flip").removeClass('border');
      $(".flip-back").html('&nbsp;').css('font-size', '');

      let input = $(this).val();
      if (input == ""){return;}
      let matches = deck.filter((v)=>{
        return v.word.startsWith(input);
      });
      for (let i of matches){
        let id = i.word.replace(/[ ()']/g, '_');
        let $back = $(`#${id} > .flip > .flip-card > .flip-back`);
        $back.html(input);
        fitText($back);
        $(`#${id} > .flip`).addClass('border');
      }
    }
  });


  let slash = false;
  $(document).on('keydown', function(e){
    if (e.target.isContentEditable || $(e.target).is('[contenteditable]')) return;
    if (e.key == "Space"){
      e.preventDefault();
    }
    if (e.key == "Enter") $("#start:visible").click();
    if (e.key == "/"){
      e.preventDefault();
      if (slash) return;

      slash = true;
      if ($(".flip.border").length > 0){
        $(".flip.border").addClass('flipped');
      }
      else{
        $(".flip:not(.flipped)").addClass('flipped')
      }
    }
  });

  $(document).on('keyup', function(e){
    if (e.key == "/"){
      $(".flip").removeClass('flipped');
      slash = false;
    }
  });


  $(document).on('mousedown', '.flip', function(e){
    e.preventDefault();
    let $card = $(this);
    $card.addClass('flipped');
    $(document).one('mouseup', function(){
      if ($card.hasClass('flip')) {
        $card.removeClass('flipped');
      }
    });
  });


  $("#exit").on('click', ()=>{
    window.location.replace('/');
  });

});

</script>

<%- include('../../foot'); -%><!-- FOOT INCLUDES SCRIPTS AND </body> -->
